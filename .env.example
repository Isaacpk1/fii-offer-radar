# Copie para .env e preencha. O arquivo .env nunca deve ir para o git.

# LLM (Google Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OFERTA_DOC_LLM_MODEL=gemini-2.5-flash
AGENT_VERBOSE=false

# Opcional: alertas por e-mail no autonomous_runner.py
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
